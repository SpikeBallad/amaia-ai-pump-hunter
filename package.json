{
  "name": "amaia-ai-pump-hunter",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "install:frontend": "npm install --prefix frontend",
    "install:backend": "python -m pip install -r backend/requirements.txt",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "python -m uvicorn backend.app.main:app --reload --host 127.0.0.1 --port 8001",
    "dev": "npx concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "app:start": "powershell -ExecutionPolicy Bypass -File .\\scripts\\start-dev.ps1",
    "app:stop": "powershell -ExecutionPolicy Bypass -File .\\scripts\\stop-dev.ps1"
  }
}
